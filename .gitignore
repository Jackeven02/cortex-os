# Build
dist/
build/
*.tsbuildinfo
*.tgz

# tsc emits to dist/ only. Any compiled output that lands in src/ (or anywhere
# else) is an accidental emit and must never be committed.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Dependencies
node_modules/

# Cortex runtime artifacts
.cortex/
*.crec
*.csnap

# Generated by projects/codebase-audit when you run it (written to the cwd)
audit-report.md

# Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# WorkBuddy local memory/skills (project-specific, not source)
.workbuddy/

# Demo capture fixtures are inputs to the GIF/HTML generators — keep them tracked
!examples/*.capture.log

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage/
.nyc_output/
