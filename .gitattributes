# Normalize line endings to LF in the repo.
# Windows contributors: git will check out CRLF locally if core.autocrlf=true,
# but the canonical form in the repo is LF.
* text=auto eol=lf

# Explicitly mark binary files (none yet, but be defensive)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Shell scripts must always be LF
*.sh text eol=lf
